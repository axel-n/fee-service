# Dev image for fee-service: JDK 25, Maven, Claude Code, and nested rootless podman for Testcontainers.
# Built and started by compose.yaml (podman compose up -d --build). Details: README.md

# podman inspect fedora:44 --format '{{index .RepoDigests 0}}'
FROM docker.io/library/fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80

# bump here; archive.apache.org keeps every release, so old pins keep building
ARG MAVEN_VERSION=3.9.16

# The container user is named like the host user (compose.yaml passes USER_NAME), so home paths match the host.
# Its IDs stay 1000: compose.yaml's keep-id:uid=1000,gid=1000 maps them to the host user, whatever the host UID is.
ARG USER_NAME=dev
ARG USER_ID=1000
ARG GROUP_ID=1000

# install + clean in ONE layer, otherwise the dnf cache stays in the image.
# The podman line is for nested containers (Testcontainers). Its helpers are listed explicitly,
# because install_weak_deps=False would leave some of them out.
RUN dnf install -y --setopt=install_weak_deps=False --nodocs \
      ca-certificates curl tar gzip unzip which \
      java-25-openjdk-devel \
      procps-ng less time jq strace \
      podman crun conmon netavark aardvark-dns passt fuse-overlayfs shadow-utils \
 && dnf clean all \
 && rm -rf /var/cache/dnf /var/log/dnf*

ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk \
    MAVEN_HOME=/opt/maven

# fail the build loudly if Fedora ever moves the JDK
RUN test -x "$JAVA_HOME/bin/javac"

# upstream Maven tarball instead of Fedora's de-bundled/patched maven package
RUN base="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
 && curl -4 --proto '=https' --tlsv1.2 -fSL --retry 5 --connect-timeout 20 -o /tmp/maven.tgz "$base" \
 && curl -4 --proto '=https' --tlsv1.2 -fSL --retry 5 --connect-timeout 20 -o /tmp/maven.tgz.sha512 "$base.sha512" \
 && echo "$(cut -d' ' -f1 /tmp/maven.tgz.sha512)  /tmp/maven.tgz" | sha512sum -c - \
 && mkdir -p "$MAVEN_HOME" \
 && tar -xzf /tmp/maven.tgz -C "$MAVEN_HOME" --strip-components=1 \
 && ln -s "$MAVEN_HOME/bin/mvn" /usr/local/bin/mvn \
 && rm -f /tmp/maven.tgz /tmp/maven.tgz.sha512

# compatibility with other tools which installed in home folder
# (.m2 pre-created so the image also works without the host mount)
RUN groupadd -g "$GROUP_ID" "$USER_NAME" \
 && useradd -m -u "$USER_ID" -g "$GROUP_ID" -s /bin/bash "$USER_NAME" \
 && install -d -o "$USER_NAME" -g "$USER_NAME" "/home/$USER_NAME/.m2"

# Nested rootless podman.
# - The subordinate IDs must lie inside the IDs this container owns (keep-id maps 0..65536), minus the user's
#   own ID. useradd allocates a range far outside that (e.g. 524288:65536), so overwrite the files instead of appending.
# - There is no systemd or journald in here: cgroups off, logs and events go to files.
# - This container is unprivileged (compose.yaml: cap_drop ALL), so nested containers must not ask for what it lacks:
#   utsns host:    seccomp allows sethostname(2) only with CAP_SYS_ADMIN, so a private UTS namespace can't be set up.
#                  Nested containers share this container's hostname; an explicit hostname is rejected.
#   /proc:/proc:   the kernel refuses a fresh procfs mount under this container's masked /proc, so bind the existing one.
#   no sysctls:    podman's default net.ipv4.ping_group_range isn't needed by any test image.
RUN printf '%s:1:%d\n%s:%d:%d\n' "$USER_NAME" $((USER_ID - 1)) "$USER_NAME" $((USER_ID + 1)) $((65535 - USER_ID)) > /etc/subuid \
 && printf '%s:1:%d\n%s:%d:%d\n' "$USER_NAME" $((GROUP_ID - 1)) "$USER_NAME" $((GROUP_ID + 1)) $((65535 - GROUP_ID)) > /etc/subgid \
 && printf '%s\n' \
      '[containers]' \
      'cgroups = "disabled"' \
      'pids_limit = 0' \
      'log_driver = "k8s-file"' \
      'utsns = "host"' \
      'volumes = ["/proc:/proc"]' \
      'default_sysctls = []' \
      '' \
      '[engine]' \
      'cgroup_manager = "cgroupfs"' \
      'events_logger = "file"' \
      > /etc/containers/containers.conf
COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh

USER $USER_NAME
WORKDIR /home/$USER_NAME

# MAVEN_ARGS is read by Maven 3.9+; -ntp drops the "Downloading ..." spam,
# which keeps build logs short for you and for Claude
ENV PATH="/home/${USER_NAME}/.local/bin:${PATH}" \
    MAVEN_ARGS="--no-transfer-progress"

# Testcontainers reaches the nested podman through this socket (started by entrypoint.sh).
# Ryuk, Testcontainers' cleanup container, needs a privileged socket mount, so it is off.
# Testcontainers then removes its containers from a JVM shutdown hook instead.
ENV XDG_RUNTIME_DIR=/tmp/run-${USER_ID} \
    DOCKER_HOST=unix:///tmp/run-${USER_ID}/podman/podman.sock \
    TESTCONTAINERS_RYUK_DISABLED=true

# Mount points for compose.yaml's named volumes (nested image storage, Claude Code state). Creating them here as the
# user means a new volume starts out owned by the user, not root.
RUN mkdir -p "/home/$USER_NAME/.local/share/containers" "/home/$USER_NAME/.claude"

# Rootless podman won't even print its version unless XDG_RUNTIME_DIR exists. entrypoint.sh creates it at run time,
# so the check makes a throwaway one and removes it again.
RUN install -d -m 0700 "$XDG_RUNTIME_DIR" \
 && java -version && javac -version && mvn -v && podman --version \
 && rm -rf "$XDG_RUNTIME_DIR"

RUN echo " " >> ~/.bash_history

# claude
RUN curl -fsSL https://claude.ai/install.sh | bash \
 && claude --version

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
# Default to bash to test the environment
CMD ["/bin/bash"]
