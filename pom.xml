<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Boot 4: Spring MVC reads and writes HTTP bodies with Jackson 3, while the Restate SDK's serde is still on
         Jackson 2. Both are on the classpath, and the api contract is written for both (PlainBigDecimal) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- The parent and aggregator of the two modules: api is the contract other services depend on, service is the
         app. Every version, and every dependency and plugin both modules use, is declared here once: a module declares
         only what it alone uses, without a version. Nothing is declared that already comes transitively -->
    <groupId>com.example</groupId>
    <artifactId>fee-service-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>fee-service-parent</name>
    <description>Transaction fee service: Kotlin, Spring Boot and a Restate workflow</description>

    <modules>
        <module>api</module>
        <module>service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <restate.version>2.11.0</restate.version>
        <!-- Built against JUnit 6 and Spring 7, as Boot 4 manages them -->
        <cucumber.version>8.0.4</cucumber.version>
        <!-- Overrides of Boot's managed versions where Boot 4.1 pins an older one than Restate SDK 2.11.0 is built against.
             Kotlin: the compiler must read the SDK's Kotlin 2.4 metadata, and Boot would pin 2.3.
             Coroutines: the Kotlin SDK needs 1.11 at runtime, and Boot would pin 1.10.
             Jackson 2 (the SDK's serde; Jackson 3, Spring's, stays as Boot manages it): the SDK needs 2.22, and Boot
             would pin 2.21. Boot imports the Jackson 2 BOM first, so jackson-annotations, which Jackson 3 shares, is
             this version too -->
        <kotlin.version>2.4.21</kotlin.version>
        <kotlin-coroutines.version>1.11.0</kotlin-coroutines.version>
        <jackson-2-bom.version>2.22.4</jackson-2-bom.version>
        <!-- Caffeine: its latest release; Boot 4.1 would pin 3.2.4 -->
        <caffeine.version>3.3.1</caffeine.version>
        <!-- Bundles ktlint 1.8.0 -->
        <ktlint-maven-plugin.version>3.7.1</ktlint-maven-plugin.version>
        <!-- mvn spring-boot:run from the root runs only the app: service sets it back to false -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
        <!-- The JVM of every test run: Surefire and Failsafe both read this property. Mockito loads as an agent instead
             of self-attaching, which recent JDKs warn about and will refuse; @{…} is read when the tests start, after
             dependency:properties has set the jar's path. Native access: the Restate SDK loads its native state machine -->
        <argLine>-javaagent:@{org.mockito:mockito-core:jar} -Xshare:off --enable-native-access=ALL-UNNAMED</argLine>
    </properties>

    <!-- Versions of what Boot's parent doesn't manage -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>fee-service-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>fee-service-api</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>dev.restate</groupId>
                <artifactId>sdk-kotlin-http</artifactId>
                <version>${restate.version}</version>
                <exclusions>
                    <!-- The SDK logs through log4j-api. Without log4j-core, Boot's log4j-to-slf4j routes it to Logback -->
                    <exclusion>
                        <groupId>org.apache.logging.log4j</groupId>
                        <artifactId>log4j-core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>dev.restate</groupId>
                <artifactId>sdk-serde-jackson</artifactId>
                <version>${restate.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Both modules have unit tests. The Kotlin stdlib needs no declaration: it comes with jackson-module-kotlin
         (api) and through api (service) -->
    <dependencies>
        <!-- JUnit 6, Mockito, AssertJ, Spring's test support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <!-- Run in both modules -->
        <plugins>
            <!-- The spring plugin opens @Component classes: Spring needs that, and so do the Restate SDK's client
                 proxies, which subclass the handler classes. The api module has no such classes, so it changes nothing
                 there -->
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- ktlint (ktlint_official style, adjusted by the root .editorconfig; main and test sources): a format
                 problem fails every build, mvn test included. mvn ktlint:format fixes what it can -->
            <plugin>
                <groupId>com.github.gantsign.maven</groupId>
                <artifactId>ktlint-maven-plugin</artifactId>
                <version>${ktlint-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ktlint-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Sets org.mockito:mockito-core:jar, the agent path in argLine -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Unit tests (*Test), mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
