<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Boot 3.5, not 4.x: Boot 4 moves Spring MVC to Jackson 3 and starter-web to starter-webmvc, while the Restate SDK
         uses Jackson 2 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- The parent and aggregator of the two modules: api is the contract other services depend on, service is the
         app. Shared versions and plugin settings live here, so both modules compile and test the same way -->
    <groupId>com.example</groupId>
    <artifactId>fee-service-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>fee-service-parent</name>
    <description>Transaction fee service: Kotlin, Spring Boot and a Restate workflow</description>

    <modules>
        <module>api</module>
        <module>service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <restate.version>2.11.0</restate.version>
        <cucumber.version>7.34.9</cucumber.version>
        <!-- Overrides of Boot's managed versions, aligned with what Restate SDK 2.11.0 is built against.
             Kotlin: the compiler must read the SDK's Kotlin 2.4 metadata, and Boot 3.5 would pin 1.9.
             Coroutines, kotlinx-serialization and Byte Buddy (the SDK's handler proxies): Boot 3.5 would pin older
             versions than the Kotlin SDK needs at runtime -->
        <kotlin.version>2.4.21</kotlin.version>
        <kotlin-coroutines.version>1.11.0</kotlin-coroutines.version>
        <kotlin-serialization.version>1.11.0</kotlin-serialization.version>
        <byte-buddy.version>1.18.3</byte-buddy.version>
        <jackson-bom.version>2.22.4</jackson-bom.version>
        <opentelemetry.version>1.58.0</opentelemetry.version>
        <!-- Cucumber 7.34 is built against JUnit 5.14 (Cucumber 8 needs JUnit 6 and Spring 7) -->
        <junit-jupiter.version>5.14.4</junit-jupiter.version>
        <!-- Bundles ktlint 1.8.0 -->
        <ktlint-maven-plugin.version>3.7.1</ktlint-maven-plugin.version>
        <!-- mvn spring-boot:run from the root runs only the app: service sets it back to false -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>fee-service-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>fee-service-api</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <configuration>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                            <!-- @JsonProperty on a constructor property must reach the parameter, or Jackson can't
                                 bind the snake_case names of the contract -->
                            <arg>-Xannotation-default-target=param-property</arg>
                        </args>
                    </configuration>
                </plugin>
                <!-- Sets ${org.mockito:mockito-core:jar}, so the tests load Mockito as an agent instead of
                     self-attaching, which recent JDKs warn about and will refuse -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>properties</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- ktlint (ktlint_official style, main and test sources): a format problem fails every build,
                     mvn test included. mvn ktlint:format fixes what it can -->
                <plugin>
                    <groupId>com.github.gantsign.maven</groupId>
                    <artifactId>ktlint-maven-plugin</artifactId>
                    <version>${ktlint-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>ktlint-check</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Unit tests (*Test), mvn test -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                        <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                    </configuration>
                </plugin>
                <!-- Integration and BDD tests (*IT), mvn verify. Boot's parent binds integration-test and verify -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                        <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
