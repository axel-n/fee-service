<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>fee-service-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!-- The app: the Spring Boot API, the Restate workflow and its endpoint. The Kotlin stdlib, kotlin-reflect and
         Jackson's Kotlin module come from the api module, the test starter from the parent -->
    <artifactId>fee-service</artifactId>
    <name>fee-service</name>
    <description>Transaction fee service: Kotlin, Spring Boot and a Restate workflow</description>

    <properties>
        <spring-boot.run.skip>false</spring-boot.run.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>fee-service-api</artifactId>
        </dependency>
        <!-- Spring MVC on Tomcat, with Jackson 3 for the HTTP bodies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Spring MVC runs a suspend controller method through Reactor: without it, the method isn't invoked. It brings
             kotlinx-coroutines-core, for the suspend Restate handlers, FeeService and controller, and
             kotlinx-coroutines-reactive, which awaits jOOQ's queries (Publishers) in the repository -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-reactor</artifactId>
        </dependency>
        <!-- The Restate Kotlin SDK: reflection-based handlers and clients, no code generation -->
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-kotlin-http</artifactId>
        </dependency>
        <!-- Jackson for everything Restate stores, instead of the Kotlin SDK's default kotlinx-serialization: the
             durable types and the api contract are Jackson-annotated, and stored records keep their JSON -->
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-serde-jackson</artifactId>
        </dependency>
        <!-- The fee records in PostgreSQL, non-blocking: Boot's R2DBC ConnectionFactory, and schema.sql run at every
             start -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-r2dbc</artifactId>
        </dependency>
        <!-- The queries: jOOQ's DSL over that ConnectionFactory, each query a Publisher awaited from a coroutine, over the
             classes generated from schema.sql (jooq-codegen-maven below). Not spring-boot-starter-jooq, which is JDBC -->
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>r2dbc-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- The connection pool: Boot pools R2DBC connections only when it is on the classpath, otherwise every
             statement opens a new connection to Postgres -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-pool</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- The local cache of charged fees in FeeService -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ContractMapper, for the tests of the durable types -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>fee-service-api</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest and MockMvc; Boot 4 keeps them out of spring-boot-starter-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The one Restate container of the ITs (RestateTestEnvironment), managed by hand: no JUnit extension -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The jOOQ classes of the fee_record table, generated as Kotlin from schema.sql in generate-sources: a
                 throwaway Postgres, started by Testcontainers when jOOQ connects, runs the script, and jOOQ reads the
                 table as Postgres made it. So the build needs a container engine, like the ITs. The classes land in
                 target/generated-sources/jooq, a compile source root, and are never checked by ktlint, which runs
                 before. The driver and Testcontainers (root pluginManagement) are on the plugin's classpath only -->
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <executions>
                    <execution>
                        <id>jooq-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Warnings and errors only, instead of the whole configuration and every generated file in each
                         build. jOOQ's logo and tip of the day come as it loads, before this applies -->
                    <logging>WARN</logging>
                    <!-- The Postgres of PostgresTestEnvironment and the dev compose (keep the versions together), with
                         schema.sql run when the container starts. It is removed when jOOQ closes its connection -->
                    <jdbc>
                        <driver>org.testcontainers.jdbc.ContainerDatabaseDriver</driver>
                        <url>jdbc:tc:postgresql:18.7:///fee?TC_INITSCRIPT=file:${project.basedir}/src/main/resources/schema.sql</url>
                    </jdbc>
                    <generator>
                        <name>org.jooq.codegen.KotlinGenerator</name>
                        <database>
                            <name>org.jooq.meta.postgres.PostgresDatabase</name>
                            <!-- The table is generated unqualified, so it lives in the schema of the app's connection -->
                            <inputSchema>public</inputSchema>
                            <outputSchemaToDefault>true</outputSchemaToDefault>
                            <forcedTypes>
                                <!-- created_at, a TIMESTAMP without a zone: bound and read as the LocalDateTime itself.
                                     jOOQ's own binding goes through java.sql.Timestamp and the JVM's default zone, which
                                     moves a time in a skipped daylight saving hour -->
                                <forcedType>
                                    <userType>java.time.LocalDateTime</userType>
                                    <binding>com.example.fee.record.ZoneFreeLocalDateTimeBinding</binding>
                                    <includeTypes>(?i:TIMESTAMP(\ WITHOUT\ TIME\ ZONE)?)</includeTypes>
                                </forcedType>
                                <!-- claimed_at and charged_at, the app's Clock: Instant, as Clock.instant() gives it -->
                                <forcedType>
                                    <name>INSTANT</name>
                                    <includeTypes>(?i:TIMESTAMP\ WITH\ TIME\ ZONE)</includeTypes>
                                </forcedType>
                            </forcedTypes>
                        </database>
                        <generate>
                            <kotlinNotNullRecordAttributes>true</kotlinNotNullRecordAttributes>
                        </generate>
                        <target>
                            <packageName>com.example.fee.record.jooq</packageName>
                            <directory>${project.build.directory}/generated-sources/jooq</directory>
                        </target>
                    </generator>
                </configuration>
            </plugin>
            <!-- Integration and BDD tests (*IT), mvn verify. Boot's parent binds integration-test and verify. No IT run
                 fails the build instead of passing empty -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin>
            <!-- The Restate SDK loads its native state machine: java -jar grants it native access through the manifest,
                 so the JDK doesn't warn -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- mvn spring-boot:run starts the app in the project root, as before the module split, so
                         a config/application.yml there still overrides the packaged defaults -->
                    <workingDirectory>${project.basedir}/..</workingDirectory>
                    <!-- spring-boot:run starts a classpath JVM, which doesn't read the manifest above -->
                    <jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
