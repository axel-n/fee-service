# fee-service: example requests for the IntelliJ HTTP Client or the VS Code REST Client.
#
# Start Restate and the app first (README, "Setup"); the API listens on port 8081 by default. Run the requests top to
# bottom: the duplicate, the conflict and the status lookups build on the requests before them.
#
# Every request is kept by Restate, so running the file again gives the same answers (the same payload returns the
# stored result and charges nothing). Change `run` to start over with new transaction ids.
#
# "# Expect:" lines document the answer: the status, then the fields the body contains (numbers compare by value, so
# 1.5 matches 1.50). HttpRequestsFileIT runs this file against the app in the tests, so they stay true.

@host = http://localhost:8081
@run = 001

### Mobile Top Up in USD: 0.15% of 1000
# Expect: 200 {"transaction_id": "mtu-{{run}}", "amount": 1000, "asset": "USD", "type": "Mobile Top Up", "fee": 1.50, "rate": 0.0015, "description": "Standard fee rate of 0.15%"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "mtu-{{run}}",
  "amount": 1000,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Bank Transfer in EUR: 0.5% of 100 is 0.50, so the minimum of 1.00 applies
# Expect: 200 {"transaction_id": "bt-{{run}}", "asset": "EUR", "type": "Bank Transfer", "fee": 1.00, "rate": 0.005, "description": "Fee rate of 0.5% (min 1.00 EUR)"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "bt-{{run}}",
  "amount": 100,
  "asset": "EUR",
  "asset_type": "FIAT",
  "type": "Bank Transfer",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Merchant Payment in USD: 1% of 1000 plus 0.30 fixed
# Expect: 200 {"transaction_id": "mp-{{run}}", "type": "Merchant Payment", "fee": 10.30, "rate": 0.01, "description": "Fee rate of 1% plus 0.30 USD fixed"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "mp-{{run}}",
  "amount": 1000,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Merchant Payment",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Cash Withdrawal in EUR: a flat 2.00, whatever the amount
# Expect: 200 {"transaction_id": "cw-{{run}}", "type": "Cash Withdrawal", "fee": 2.00, "rate": 0, "description": "Flat fee of 2.00 EUR"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "cw-{{run}}",
  "amount": 50.25,
  "asset": "EUR",
  "asset_type": "FIAT",
  "type": "Cash Withdrawal",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Duplicate: the Mobile Top Up again, same payload. Same response, and the wallet is not charged again
# Expect: 200 {"transaction_id": "mtu-{{run}}", "fee": 1.50, "description": "Standard fee rate of 0.15%"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "mtu-{{run}}",
  "amount": 1000,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Conflict: the charged Mobile Top Up id with another amount. The fee was already charged, so 409
# Expect: 409 {"status": 409, "transaction_id": "mtu-{{run}}"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "mtu-{{run}}",
  "amount": 2000,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Rejected: the transaction is still PENDING. Only SETTLED - PENDING FEE is processed
# Expect: 422 {"field": "state", "value": "PENDING", "detail": "Unsupported state 'PENDING'. Supported: 'SETTLED - PENDING FEE'"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "settle-{{run}}",
  "amount": 250,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Bank Transfer",
  "state": "PENDING",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Corrected: the same id once settled. A rejection doesn't use up the id, so this one is charged
# Expect: 200 {"transaction_id": "settle-{{run}}", "type": "Bank Transfer", "fee": 1.25, "rate": 0.005, "description": "Fee rate of 0.5% (min 1.00 USD)"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "settle-{{run}}",
  "amount": 250,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Bank Transfer",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Invalid payload: not JSON at all
# Expect: 400 {"status": 400}
POST {{host}}/transaction/fee
Content-Type: application/json

{ "transaction_id": "broken-{{run}}", "amount":

### Invalid payload: a required field (asset) is missing
# Expect: 400 {"field": "asset", "value": null}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "missing-{{run}}",
  "amount": 1000,
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Invalid payload: the amount is not positive
# Expect: 400 {"field": "amount", "value": "-5", "detail": "Invalid amount '-5'. Allowed: a number greater than 0"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "negative-{{run}}",
  "amount": -5,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Invalid payload: created_at isn't "yyyy-MM-dd HH:mm:ss[.fraction]"
# Expect: 400 {"field": "created_at", "value": "2023-08-30T15:42:17Z"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "date-{{run}}",
  "amount": 1000,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30T15:42:17Z"
}

### Invalid payload: created_at is in the future (read as UTC)
# Expect: 400 {"field": "created_at", "value": "2999-01-01 00:00:00"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "future-{{run}}",
  "amount": 1000,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2999-01-01 00:00:00"
}

### Invalid payload: the transaction_id has characters outside letters, digits, _ and -
# Expect: 400 {"field": "transaction_id", "value": "txn 001!"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "txn 001!",
  "amount": 1000,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Unsupported: an asset other than USD and EUR
# Expect: 422 {"field": "asset", "value": "BTC"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "btc-{{run}}",
  "amount": 1000,
  "asset": "BTC",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Unsupported: a transaction type without a fee rule
# Expect: 422 {"field": "type", "value": "Crypto Swap"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "swap-{{run}}",
  "amount": 1000,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Crypto Swap",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Unsupported: more decimals than the asset has (USD has 2)
# Expect: 422 {"field": "amount", "value": "10.001", "detail": "Amount 10.001 has 3 decimals. USD allows 2"}
POST {{host}}/transaction/fee
Content-Type: application/json

{
  "transaction_id": "cents-{{run}}",
  "amount": 10.001,
  "asset": "USD",
  "asset_type": "FIAT",
  "type": "Mobile Top Up",
  "state": "SETTLED - PENDING FEE",
  "created_at": "2023-08-30 15:42:17.610059"
}

### Status lookup: the charged Mobile Top Up. The 409 above changed nothing
# Expect: 200 {"transaction_id": "mtu-{{run}}", "status": "COMPLETED", "amount": 1000, "fee": 1.50, "description": "Standard fee rate of 0.15%"}
GET {{host}}/transaction/fee/mtu-{{run}}

### Status lookup: the corrected transaction
# Expect: 200 {"transaction_id": "settle-{{run}}", "status": "COMPLETED", "fee": 1.25}
GET {{host}}/transaction/fee/settle-{{run}}

### Status lookup: a rejected transaction is never recorded
# Expect: 404 {"transaction_id": "btc-{{run}}"}
GET {{host}}/transaction/fee/btc-{{run}}

### Status lookup: an id that was never sent
# Expect: 404 {"transaction_id": "unknown-{{run}}", "detail": "No fee record for transaction 'unknown-{{run}}'"}
GET {{host}}/transaction/fee/unknown-{{run}}
