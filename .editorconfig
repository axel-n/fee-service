root = true

# ktlint keeps its ktlint_official style; only this differs from it.
[*.{kt,kts}]
# A function signature that fits on one line stays on one line. ktlint_official would put each parameter on a line of its
# own as soon as a function has two of them.
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = unset
