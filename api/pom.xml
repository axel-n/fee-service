<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>fee-service-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!-- What other services depend on to call the fee service: the request and response bodies, the exceptions and the
         problem body of its errors. Only Jackson and Kotlin at compile scope: no Spring, no Restate -->
    <artifactId>fee-service-api</artifactId>
    <name>fee-service-api</name>
    <description>The HTTP contract of fee-service: request and response DTOs, exceptions and the error body</description>

    <dependencies>
        <!-- The DTOs are Kotlin data classes without a no-arg constructor: a consumer's mapper needs the Kotlin module.
             The contract is read and written by both Jackson generations, so it carries both: Jackson 3 for HTTP (Spring
             MVC on Boot 4, and consumers on it), Jackson 2 for the Restate journal (and consumers still on it). Each
             brings its jackson-databind, the jackson-annotations they share, kotlin-reflect and the Kotlin stdlib, here
             and to the service -->
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>

        <!-- The Jackson 2 mapper the contract meets in the journal (ContractMapper.RESTATE). Brings Restate's common
             (Slice) too -->

        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-serde-jackson</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The test-jar shares ContractMapper with the service's tests of its durable types -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
